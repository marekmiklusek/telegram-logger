{
    "name": "marekmiklusek/telegram-logger",
    "description": "A Laravel package to send logs to Telegram.",
    "type": "library",
    "keywords": ["php", "laravel", "package", "telegram", "logger", "laravel-telegram-logger"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Miklusek",
            "email": "marek.miklusek@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.31"
    },
    "autoload": {
        "psr-4": {
            "MarekMiklusek\\TelegramLogger\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MarekMiklusek\\TelegramLogger\\TelegramLoggerServiceProvider"
            ]
        }
    }
}
