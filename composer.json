{
    "name": "marekmiklusek/telegram-logger",
    "description": "A Laravel package to send logs to Telegram.",
    "type": "library",
    "keywords": ["php", "laravel", "package", "telegram", "logger", "laravel-telegram-logger"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Miklusek",
            "email": "marek.miklusek@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "MarekMiklusek\\TelegramLogger\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarekMiklusek\\TelegramLogger\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:types": "phpstan analyse",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "MarekMiklusek\\TelegramLogger\\TelegramLoggerServiceProvider"
            ]
        }
    }
}
